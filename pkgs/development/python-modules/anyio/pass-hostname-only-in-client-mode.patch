diff --git a/src/anyio/streams/tls.py b/src/anyio/streams/tls.py
index b9ddf1d33..8ac6db784 100644
--- a/src/anyio/streams/tls.py
+++ b/src/anyio/streams/tls.py
@@ -143,7 +143,9 @@ async def wrap(
 
         # Resolve international host names using IDNA 2008.
         # Otherwise wrap_bio() would resolve them with IDNA 2003.
-        if hostname is not None:
+        # The server side never sends a host name, and newer Python versions refuse
+        # one there (https://github.com/python/cpython/issues/156793).
+        if hostname is not None and not server_side:
             from .._core._sockets import idna2008_resolve
 
             server_hostname: bytes | None = idna2008_resolve(hostname)
diff --git a/tests/streams/test_tls.py b/tests/streams/test_tls.py
index 07334c392..4ddbf8d35 100644
--- a/tests/streams/test_tls.py
+++ b/tests/streams/test_tls.py
@@ -475,6 +475,37 @@ def serve_sync() -> None:
                     stream, hostname="localhost", ssl_context=client_context
                 )
 
+    async def test_server_side_ignores_hostname(
+        self, server_context: ssl.SSLContext, client_context: ssl.SSLContext
+    ) -> None:
+        server_send, server_receive = create_memory_object_stream[bytes](1)
+        client_send, client_receive = create_memory_object_stream[bytes](1)
+        client_stream = StapledObjectStream(client_send, server_receive)
+        server_stream = StapledObjectStream(server_send, client_receive)
+        server_hostname: str | None = "unset"
+
+        async def server() -> None:
+            nonlocal server_hostname
+            async with await TLSStream.wrap(
+                server_stream,
+                server_side=True,
+                hostname="localhost",
+                ssl_context=server_context,
+            ) as server_tls_stream:
+                ssl_object = server_tls_stream.extra(TLSAttribute.ssl_object)
+                server_hostname = ssl_object.server_hostname
+                await server_tls_stream.send(await server_tls_stream.receive())
+
+        async with create_task_group() as tg:
+            tg.start_soon(server)
+            async with await TLSStream.wrap(
+                client_stream, hostname="localhost", ssl_context=client_context
+            ) as client_tls_stream:
+                await client_tls_stream.send(b"hello")
+                assert await client_tls_stream.receive() == b"hello"
+
+        assert server_hostname is None
+
 
